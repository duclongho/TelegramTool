//@version=6
indicator(title="Rich Trading", overlay=true)

// Inputs
a       = input.int(1,      title="Key Value. 'This changes the sensitivity'")
c       = input.int(10,     title="ATR Period")
h       = input.bool(false, title="Signals from Heikin Ashi Candles")
sl_pts  = input.float(10.0, title="Stop Loss (giá)",      minval=0.1, step=0.1)
tp1_pts = input.float(5.0,  title="Take Profit 1 (giá)",  minval=0.1, step=0.1)
tp2_pts = input.float(10.0, title="Take Profit 2 (giá)",  minval=0.1, step=0.1)
tp3_pts = input.float(15.0, title="Take Profit 3 (giá)",  minval=0.1, step=0.1)
tp4_pts = input.float(20.0, title="Take Profit 4 (giá)",  minval=0.1, step=0.1)
tp5_pts = input.float(25.0, title="Take Profit 5 (giá)",  minval=0.1, step=0.1)

xATR  = ta.atr(c)
nLoss = a * xATR

src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close) : close

var float xATRTrailingStop = 0.0
xATRTrailingStop := src > nz(xATRTrailingStop[1]) and src[1] > nz(xATRTrailingStop[1]) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) :
   src < nz(xATRTrailingStop[1]) and src[1] < nz(xATRTrailingStop[1]) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) :
   src > nz(xATRTrailingStop[1]) ? src - nLoss : src + nLoss

var int pos = 0
pos := src[1] < nz(xATRTrailingStop[1]) and src > nz(xATRTrailingStop[1]) ? 1 :
   src[1] > nz(xATRTrailingStop[1]) and src < nz(xATRTrailingStop[1]) ? -1 : nz(pos[1], 0)

ema_val = ta.ema(src, 1)
above   = ta.crossover(ema_val, xATRTrailingStop)
below   = ta.crossover(xATRTrailingStop, ema_val)

buy  = src > xATRTrailingStop and above
sell = src < xATRTrailingStop and below

barbuy  = src > xATRTrailingStop
barsell = src < xATRTrailingStop

// --- THEO DÕI VỊ THẾ & SL/TP ---
var float tp1_level  = na
var float tp2_level  = na
var float tp3_level  = na
var float tp4_level  = na
var float tp5_level  = na
var float sl_level   = na
var int   trade_dir  = 0
var line  ln_tp1     = na
var line  ln_tp2     = na
var line  ln_tp3     = na
var line  ln_tp4     = na
var line  ln_tp5     = na
var line  ln_sl      = na

// Lưu riêng để dùng trong alert (không bị TP handler xóa)
var float entry_tp1  = na
var float entry_tp2  = na
var float entry_tp3  = na
var float entry_tp4  = na
var float entry_tp5  = na
var float entry_sl   = na

// Vào lệnh mới khi: chưa có lệnh (trade_dir==0) HOẶC đã hit TP1 (tp1_level==na)
long_entry  = buy  and (trade_dir == 0 or na(tp1_level))
short_entry = sell and (trade_dir == 0 or na(tp1_level))

if long_entry
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_tp2)
        line.delete(ln_tp2)
    if not na(ln_tp3)
        line.delete(ln_tp3)
    if not na(ln_tp4)
        line.delete(ln_tp4)
    if not na(ln_tp5)
        line.delete(ln_tp5)
    if not na(ln_sl)
        line.delete(ln_sl)
    trade_dir := 1
    tp1_level := close + tp1_pts
    tp2_level := close + tp2_pts
    tp3_level := close + tp3_pts
    tp4_level := close + tp4_pts
    tp5_level := close + tp5_pts
    sl_level  := close - sl_pts
    entry_tp1 := tp1_level
    entry_tp2 := tp2_level
    entry_tp3 := tp3_level
    entry_tp4 := tp4_level
    entry_tp5 := tp5_level
    entry_sl  := sl_level
    ln_tp1 := line.new(bar_index, tp1_level, bar_index+1, tp1_level, color=color.new(color.green, 70), width=1, extend=extend.right)
    ln_tp2 := line.new(bar_index, tp2_level, bar_index+1, tp2_level, color=color.new(color.green, 50), width=1, extend=extend.right)
    ln_tp3 := line.new(bar_index, tp3_level, bar_index+1, tp3_level, color=color.new(color.green, 30), width=1, extend=extend.right)
    ln_tp4 := line.new(bar_index, tp4_level, bar_index+1, tp4_level, color=color.new(color.green, 10), width=2, extend=extend.right)
    ln_tp5 := line.new(bar_index, tp5_level, bar_index+1, tp5_level, color=color.green,               width=2, extend=extend.right)
    ln_sl  := line.new(bar_index, sl_level,  bar_index+1, sl_level,  color=color.red,                 width=1, extend=extend.right)

if short_entry
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_tp2)
        line.delete(ln_tp2)
    if not na(ln_tp3)
        line.delete(ln_tp3)
    if not na(ln_tp4)
        line.delete(ln_tp4)
    if not na(ln_tp5)
        line.delete(ln_tp5)
    if not na(ln_sl)
        line.delete(ln_sl)
    trade_dir := -1
    tp1_level := close - tp1_pts
    tp2_level := close - tp2_pts
    tp3_level := close - tp3_pts
    tp4_level := close - tp4_pts
    tp5_level := close - tp5_pts
    sl_level  := close + sl_pts
    entry_tp1 := tp1_level
    entry_tp2 := tp2_level
    entry_tp3 := tp3_level
    entry_tp4 := tp4_level
    entry_tp5 := tp5_level
    entry_sl  := sl_level
    ln_tp1 := line.new(bar_index, tp1_level, bar_index+1, tp1_level, color=color.new(color.green, 70), width=1, extend=extend.right)
    ln_tp2 := line.new(bar_index, tp2_level, bar_index+1, tp2_level, color=color.new(color.green, 50), width=1, extend=extend.right)
    ln_tp3 := line.new(bar_index, tp3_level, bar_index+1, tp3_level, color=color.new(color.green, 30), width=1, extend=extend.right)
    ln_tp4 := line.new(bar_index, tp4_level, bar_index+1, tp4_level, color=color.new(color.green, 10), width=2, extend=extend.right)
    ln_tp5 := line.new(bar_index, tp5_level, bar_index+1, tp5_level, color=color.green,               width=2, extend=extend.right)
    ln_sl  := line.new(bar_index, sl_level,  bar_index+1, sl_level,  color=color.red,                 width=1, extend=extend.right)

// Kiểm tra TP/SL bị chạm (ưu tiên TP cao nhất trước: TP5 > TP4 > TP3 > TP2 > TP1)
long_tp5_hit  = trade_dir ==  1 and not na(tp5_level) and high >= tp5_level
long_tp4_hit  = trade_dir ==  1 and not na(tp4_level) and high >= tp4_level and not long_tp5_hit
long_tp3_hit  = trade_dir ==  1 and not na(tp3_level) and high >= tp3_level and not long_tp4_hit and not long_tp5_hit
long_tp2_hit  = trade_dir ==  1 and not na(tp2_level) and high >= tp2_level and not long_tp3_hit and not long_tp4_hit and not long_tp5_hit
long_tp1_hit  = trade_dir ==  1 and not na(tp1_level) and high >= tp1_level and not long_tp2_hit and not long_tp3_hit and not long_tp4_hit and not long_tp5_hit
long_sl_hit   = trade_dir ==  1 and not na(sl_level)  and low  <= sl_level  and not long_entry

short_tp5_hit = trade_dir == -1 and not na(tp5_level) and low  <= tp5_level
short_tp4_hit = trade_dir == -1 and not na(tp4_level) and low  <= tp4_level and not short_tp5_hit
short_tp3_hit = trade_dir == -1 and not na(tp3_level) and low  <= tp3_level and not short_tp4_hit and not short_tp5_hit
short_tp2_hit = trade_dir == -1 and not na(tp2_level) and low  <= tp2_level and not short_tp3_hit and not short_tp4_hit and not short_tp5_hit
short_tp1_hit = trade_dir == -1 and not na(tp1_level) and low  <= tp1_level and not short_tp2_hit and not short_tp3_hit and not short_tp4_hit and not short_tp5_hit
short_sl_hit  = trade_dir == -1 and not na(sl_level)  and high >= sl_level  and not short_entry

var float hit_price = na

// TP5 bị chạm: xóa TP1→TP5, lệnh vẫn sống chờ SL hoặc tín hiệu mới
if long_tp5_hit or short_tp5_hit
    hit_price := tp5_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4    := na
        tp4_level := na
    if not na(ln_tp5)
        line.delete(ln_tp5)
        ln_tp5    := na
        tp5_level := na

// TP4 bị chạm: xóa TP1→TP4, TP5 vẫn hiển thị
if long_tp4_hit or short_tp4_hit
    hit_price := tp4_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4    := na
        tp4_level := na

// TP3 bị chạm: xóa TP1→TP3, TP4+TP5 vẫn hiển thị
if long_tp3_hit or short_tp3_hit
    hit_price := tp3_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na

// TP2 bị chạm: xóa TP1+TP2, TP3→TP5 vẫn hiển thị
if long_tp2_hit or short_tp2_hit
    hit_price := tp2_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na

// TP1 bị chạm: xóa TP1 và SL, TP2→TP5 vẫn hiển thị
if long_tp1_hit or short_tp1_hit
    hit_price := tp1_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

// SL bị chạm: đóng lệnh hoàn toàn, xóa tất cả đường
if long_sl_hit or short_sl_hit
    hit_price := sl_level
    trade_dir := 0
    tp1_level := na
    tp2_level := na
    tp3_level := na
    tp4_level := na
    tp5_level := na
    sl_level  := na
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1 := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2 := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3 := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4 := na
    if not na(ln_tp5)
        line.delete(ln_tp5)
        ln_tp5 := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl := na

// --- HIỂN THỊ ---
plotshape(long_entry,  title="Buy",  text="Buy",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(short_entry, title="Sell", text="Sell", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)

barcolor(barbuy  ? color.green : na)
barcolor(barsell ? color.red   : na)

// --- ALERTS ---
_t  = syminfo.ticker
_ex = syminfo.prefix
_tf = timeframe.period
_c  = str.tostring(close, "#.##")

_hp = str.tostring(hit_price, "#.##")
_base = '","interval":"' + _tf + '","exchange":"' + _ex + '"}'

if long_entry
    alert('{"signal":"UT Long","ticker":"' + _t + '","close":"' + _c + '","tp1":"' + str.tostring(entry_tp1, "#.##") + '","tp2":"' + str.tostring(entry_tp2, "#.##") + '","tp3":"' + str.tostring(entry_tp3, "#.##") + '","tp4":"' + str.tostring(entry_tp4, "#.##") + '","tp5":"' + str.tostring(entry_tp5, "#.##") + '","sl":"' + str.tostring(entry_sl, "#.##") + _base, alert.freq_once_per_bar_close)

if short_entry
    alert('{"signal":"UT Short","ticker":"' + _t + '","close":"' + _c + '","tp1":"' + str.tostring(entry_tp1, "#.##") + '","tp2":"' + str.tostring(entry_tp2, "#.##") + '","tp3":"' + str.tostring(entry_tp3, "#.##") + '","tp4":"' + str.tostring(entry_tp4, "#.##") + '","tp5":"' + str.tostring(entry_tp5, "#.##") + '","sl":"' + str.tostring(entry_sl, "#.##") + _base, alert.freq_once_per_bar_close)

if long_tp1_hit
    alert('{"signal":"UT Long TP1","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if long_tp2_hit
    alert('{"signal":"UT Long TP2","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if long_tp3_hit
    alert('{"signal":"UT Long TP3","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if long_tp4_hit
    alert('{"signal":"UT Long TP4","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if long_tp5_hit
    alert('{"signal":"UT Long TP5","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if long_sl_hit
    alert('{"signal":"UT Long SL","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)

if short_tp1_hit
    alert('{"signal":"UT Short TP1","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if short_tp2_hit
    alert('{"signal":"UT Short TP2","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if short_tp3_hit
    alert('{"signal":"UT Short TP3","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if short_tp4_hit
    alert('{"signal":"UT Short TP4","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if short_tp5_hit
    alert('{"signal":"UT Short TP5","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
if short_sl_hit
    alert('{"signal":"UT Short SL","ticker":"' + _t + '","close":"' + _c + '","hit_price":"' + _hp + _base, alert.freq_once_per_bar)
