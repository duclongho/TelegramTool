//@version=6
indicator(title="Rich Trading + EMA Filter", overlay=true)

// Inputs
a       = input.int(1,      title="Key Value. 'This changes the sensitivity'")
c       = input.int(10,     title="ATR Period")
h       = input.bool(false, title="Signals from Heikin Ashi Candles")
sl_pts  = input.float(10.0, title="Stop Loss (giá)",                    minval=0.1, step=0.1)
tp1_pts = input.float(5.0,  title="Take Profit 1 (giá)  — 0 = bỏ qua", minval=0.0, step=0.1)
tp2_pts = input.float(10.0, title="Take Profit 2 (giá)  — 0 = bỏ qua", minval=0.0, step=0.1)
tp3_pts = input.float(15.0, title="Take Profit 3 (giá)  — 0 = bỏ qua", minval=0.0, step=0.1)
tp4_pts = input.float(20.0, title="Take Profit 4 (giá)  — 0 = bỏ qua", minval=0.0, step=0.1)
tp5_pts = input.float(25.0, title="Take Profit 5 (giá)  — 0 = bỏ qua", minval=0.0, step=0.1)

// Lọc TP = 0 và sắp xếp lại thứ tự
_tp_raw  = array.from(tp1_pts, tp2_pts, tp3_pts, tp4_pts, tp5_pts)
_tp_filt = array.new_float(0)
for _v in _tp_raw
    if _v > 0
        array.push(_tp_filt, _v)
eff_tp1 = array.size(_tp_filt) >= 1 ? array.get(_tp_filt, 0) : 0.0
eff_tp2 = array.size(_tp_filt) >= 2 ? array.get(_tp_filt, 1) : 0.0
eff_tp3 = array.size(_tp_filt) >= 3 ? array.get(_tp_filt, 2) : 0.0
eff_tp4 = array.size(_tp_filt) >= 4 ? array.get(_tp_filt, 3) : 0.0
eff_tp5 = array.size(_tp_filt) >= 5 ? array.get(_tp_filt, 4) : 0.0

// EMA Filter
ema_len = input.int(200,   title="EMA Period (lọc xu hướng)", minval=1,    group="EMA Filter")
ema_src = input.source(close, title="EMA Source",              group="EMA Filter")
use_ema = input.bool(true,  title="Bật lọc theo EMA",          group="EMA Filter")

xATR  = ta.atr(c)
nLoss = a * xATR

src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close) : close

// EMA filter
ema_val_filter = ta.ema(ema_src, ema_len)
above_ema = src > ema_val_filter
below_ema = src < ema_val_filter

var float xATRTrailingStop = 0.0
xATRTrailingStop := src > nz(xATRTrailingStop[1]) and src[1] > nz(xATRTrailingStop[1]) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) :
   src < nz(xATRTrailingStop[1]) and src[1] < nz(xATRTrailingStop[1]) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) :
   src > nz(xATRTrailingStop[1]) ? src - nLoss : src + nLoss

var int pos = 0
pos := src[1] < nz(xATRTrailingStop[1]) and src > nz(xATRTrailingStop[1]) ? 1 :
   src[1] > nz(xATRTrailingStop[1]) and src < nz(xATRTrailingStop[1]) ? -1 : nz(pos[1], 0)

ema_val = ta.ema(src, 1)
above   = ta.crossover(ema_val, xATRTrailingStop)
below   = ta.crossover(xATRTrailingStop, ema_val)

buy_raw  = src > xATRTrailingStop and above
sell_raw = src < xATRTrailingStop and below

buy  = use_ema ? (buy_raw  and above_ema) : buy_raw
sell = use_ema ? (sell_raw and below_ema) : sell_raw

barbuy  = src > xATRTrailingStop
barsell = src < xATRTrailingStop

// --- THEO DÕI VỊ THẾ & SL/TP ---
var float tp1_level  = na
var float tp2_level  = na
var float tp3_level  = na
var float tp4_level  = na
var float tp5_level  = na
var float sl_level   = na
var int   trade_dir  = 0
var line  ln_tp1     = na
var line  ln_tp2     = na
var line  ln_tp3     = na
var line  ln_tp4     = na
var line  ln_tp5     = na
var line  ln_sl      = na

var float entry_tp1      = na
var float entry_tp2      = na
var float entry_tp3      = na
var float entry_tp4      = na
var float entry_tp5      = na
var float entry_sl       = na
var float entry_close      = na
var int   entry_bar_index  = -1
var bool  entry_alert_sent = false
var bool  entry_confirmed  = false

long_entry  = buy  and (trade_dir == 0 or na(tp1_level))
short_entry = sell and (trade_dir == 0 or na(tp1_level))

// --- HÀM TẠO CHUỖI GIÁ ---
_fmt(v) => str.tostring(v, "#.##")

// --- HÀM FORMAT KHUNG THỜI GIAN ---
_fmt_tf(tf) =>
    if tf == "D"
        "D1"
    else if tf == "W"
        "W1"
    else if tf == "M"
        "MN"
    else
        _m = str.tonumber(tf)
        if _m >= 60
            "H" + str.tostring(int(_m / 60))
        else
            "M" + tf

if long_entry
    entry_close      := close
    entry_bar_index  := bar_index
    entry_alert_sent := false
    trade_dir := 1
    tp1_level := eff_tp1 > 0 ? close + eff_tp1 : na
    tp2_level := eff_tp2 > 0 ? close + eff_tp2 : na
    tp3_level := eff_tp3 > 0 ? close + eff_tp3 : na
    tp4_level := eff_tp4 > 0 ? close + eff_tp4 : na
    tp5_level := eff_tp5 > 0 ? close + eff_tp5 : na
    sl_level  := close - sl_pts
    entry_tp1 := tp1_level
    entry_tp2 := tp2_level
    entry_tp3 := tp3_level
    entry_tp4 := tp4_level
    entry_tp5 := tp5_level
    entry_sl  := sl_level

if short_entry
    entry_close      := close
    entry_bar_index  := bar_index
    entry_alert_sent := false
    trade_dir := -1
    tp1_level := eff_tp1 > 0 ? close - eff_tp1 : na
    tp2_level := eff_tp2 > 0 ? close - eff_tp2 : na
    tp3_level := eff_tp3 > 0 ? close - eff_tp3 : na
    tp4_level := eff_tp4 > 0 ? close - eff_tp4 : na
    tp5_level := eff_tp5 > 0 ? close - eff_tp5 : na
    sl_level  := close + sl_pts
    entry_tp1 := tp1_level
    entry_tp2 := tp2_level
    entry_tp3 := tp3_level
    entry_tp4 := tp4_level
    entry_tp5 := tp5_level
    entry_sl  := sl_level

if (long_entry or short_entry) and barstate.isconfirmed
    entry_confirmed := true

// Vẽ đường TP/SL khi vào lệnh
if entry_confirmed and long_entry
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_tp2)
        line.delete(ln_tp2)
    if not na(ln_tp3)
        line.delete(ln_tp3)
    if not na(ln_tp4)
        line.delete(ln_tp4)
    if not na(ln_tp5)
        line.delete(ln_tp5)
    if not na(ln_sl)
        line.delete(ln_sl)
    ln_tp1 := line.new(bar_index, tp1_level, bar_index+1, tp1_level, color=color.new(color.green, 70), width=1, extend=extend.right)
    ln_tp2 := line.new(bar_index, tp2_level, bar_index+1, tp2_level, color=color.new(color.green, 50), width=1, extend=extend.right)
    ln_tp3 := line.new(bar_index, tp3_level, bar_index+1, tp3_level, color=color.new(color.green, 30), width=1, extend=extend.right)
    ln_tp4 := line.new(bar_index, tp4_level, bar_index+1, tp4_level, color=color.new(color.green, 10), width=2, extend=extend.right)
    ln_tp5 := line.new(bar_index, tp5_level, bar_index+1, tp5_level, color=color.green,               width=2, extend=extend.right)
    ln_sl  := line.new(bar_index, sl_level,  bar_index+1, sl_level,  color=color.red,                 width=1, extend=extend.right)

if entry_confirmed and short_entry
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_tp2)
        line.delete(ln_tp2)
    if not na(ln_tp3)
        line.delete(ln_tp3)
    if not na(ln_tp4)
        line.delete(ln_tp4)
    if not na(ln_tp5)
        line.delete(ln_tp5)
    if not na(ln_sl)
        line.delete(ln_sl)
    ln_tp1 := line.new(bar_index, tp1_level, bar_index+1, tp1_level, color=color.new(color.green, 70), width=1, extend=extend.right)
    ln_tp2 := line.new(bar_index, tp2_level, bar_index+1, tp2_level, color=color.new(color.green, 50), width=1, extend=extend.right)
    ln_tp3 := line.new(bar_index, tp3_level, bar_index+1, tp3_level, color=color.new(color.green, 30), width=1, extend=extend.right)
    ln_tp4 := line.new(bar_index, tp4_level, bar_index+1, tp4_level, color=color.new(color.green, 10), width=2, extend=extend.right)
    ln_tp5 := line.new(bar_index, tp5_level, bar_index+1, tp5_level, color=color.green,               width=2, extend=extend.right)
    ln_sl  := line.new(bar_index, sl_level,  bar_index+1, sl_level,  color=color.red,                 width=1, extend=extend.right)

// --- ĐIỀU KIỆN TP/SL ---
_long_tp1_raw  = entry_confirmed and trade_dir ==  1 and not na(tp1_level) and high >= tp1_level and not long_entry
_short_tp1_raw = entry_confirmed and trade_dir == -1 and not na(tp1_level) and low  <= tp1_level and not short_entry

long_sl_hit  = entry_confirmed and trade_dir ==  1 and not na(sl_level) and low  <= sl_level  and not long_entry  and not _long_tp1_raw
short_sl_hit = entry_confirmed and trade_dir == -1 and not na(sl_level) and high >= sl_level  and not short_entry and not _short_tp1_raw

long_tp5_hit  = entry_confirmed and trade_dir ==  1 and not na(tp5_level) and high >= tp5_level and not long_sl_hit and not long_entry
long_tp4_hit  = entry_confirmed and trade_dir ==  1 and not na(tp4_level) and high >= tp4_level and not long_tp5_hit  and not long_sl_hit and not long_entry
long_tp3_hit  = entry_confirmed and trade_dir ==  1 and not na(tp3_level) and high >= tp3_level and not long_tp4_hit  and not long_tp5_hit  and not long_sl_hit and not long_entry
long_tp2_hit  = entry_confirmed and trade_dir ==  1 and not na(tp2_level) and high >= tp2_level and not long_tp3_hit  and not long_tp4_hit  and not long_tp5_hit  and not long_sl_hit and not long_entry
long_tp1_hit  = _long_tp1_raw  and not long_tp2_hit and not long_tp3_hit and not long_tp4_hit and not long_tp5_hit and not long_sl_hit

short_tp5_hit = entry_confirmed and trade_dir == -1 and not na(tp5_level) and low  <= tp5_level and not short_sl_hit and not short_entry
short_tp4_hit = entry_confirmed and trade_dir == -1 and not na(tp4_level) and low  <= tp4_level and not short_tp5_hit and not short_sl_hit and not short_entry
short_tp3_hit = entry_confirmed and trade_dir == -1 and not na(tp3_level) and low  <= tp3_level and not short_tp4_hit and not short_tp5_hit and not short_sl_hit and not short_entry
short_tp2_hit = entry_confirmed and trade_dir == -1 and not na(tp2_level) and low  <= tp2_level and not short_tp3_hit and not short_tp4_hit and not short_tp5_hit and not short_sl_hit and not short_entry
short_tp1_hit = _short_tp1_raw and not short_tp2_hit and not short_tp3_hit and not short_tp4_hit and not short_tp5_hit and not short_sl_hit

var float hit_price = na

// --- XÓA ĐƯỜNG KHI CHẠM MỨC ---
if long_tp5_hit or short_tp5_hit
    hit_price := tp5_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4    := na
        tp4_level := na
    if not na(ln_tp5)
        line.delete(ln_tp5)
        ln_tp5    := na
        tp5_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

if long_tp4_hit or short_tp4_hit
    hit_price := tp4_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4    := na
        tp4_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

if long_tp3_hit or short_tp3_hit
    hit_price := tp3_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3    := na
        tp3_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

if long_tp2_hit or short_tp2_hit
    hit_price := tp2_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2    := na
        tp2_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

if long_tp1_hit or short_tp1_hit
    hit_price := tp1_level
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1    := na
        tp1_level := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl    := na
        sl_level := na

if long_sl_hit or short_sl_hit
    hit_price       := sl_level
    entry_confirmed := false
    trade_dir       := 0
    tp1_level := na
    tp2_level := na
    tp3_level := na
    tp4_level := na
    tp5_level := na
    sl_level  := na
    if not na(ln_tp1)
        line.delete(ln_tp1)
        ln_tp1 := na
    if not na(ln_tp2)
        line.delete(ln_tp2)
        ln_tp2 := na
    if not na(ln_tp3)
        line.delete(ln_tp3)
        ln_tp3 := na
    if not na(ln_tp4)
        line.delete(ln_tp4)
        ln_tp4 := na
    if not na(ln_tp5)
        line.delete(ln_tp5)
        ln_tp5 := na
    if not na(ln_sl)
        line.delete(ln_sl)
        ln_sl := na

// --- PANEL TÍN HIỆU VÀO LỆNH ---
string panel_pos  = input.string(position.top_right, title="Vị trí panel",
     options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left],
     group="Panel thông báo")
string panel_size = input.string(size.normal, title="Kích thước chữ",
     options=[size.tiny, size.small, size.normal, size.large, size.huge],
     group="Panel thông báo")

// Lưu thông tin lệnh gần nhất
var string p_header = "—"
var string p_tf     = "—"
var string p_entry  = "—"
var string p_sl     = "—"
var string p_time   = "—"
var color  p_hdr_bg = color.new(color.gray, 30)

if long_entry
    p_header := "🟢 BUY  ▲ | " + syminfo.ticker
    p_tf     := "⏱️ Khung: " + _fmt_tf(timeframe.period)
    p_entry  := "💰 Giá vào: " + _fmt(entry_close)
    p_sl     := "🛑 SL:  "    + _fmt(entry_sl)
    p_time   := "🕐 " + str.format_time(time, "HH:mm  dd/MM/yyyy", syminfo.timezone)
    p_hdr_bg := color.new(color.teal, 20)

if short_entry
    p_header := "🔴 SELL ▼ | " + syminfo.ticker
    p_tf     := "⏱️ Khung: " + _fmt_tf(timeframe.period)
    p_entry  := "💰 Giá vào: " + _fmt(entry_close)
    p_sl     := "🛑 SL:  "    + _fmt(entry_sl)
    p_time   := "🕐 " + str.format_time(time, "HH:mm  dd/MM/yyyy", syminfo.timezone)
    p_hdr_bg := color.new(color.maroon, 20)

if barstate.islast
    _bg     = color.new(color.black, 20)
    _clr_tp = color.new(color.green, 20)
    _clr_sl = color.new(color.red,   20)
    _clr_gw = color.new(color.gray,  20)
    _sz     = panel_size

    // Gom TP có giá trị (khác na), tự đánh số lại
    _tp_vals = array.new_float(0)
    if not na(entry_tp1)
        array.push(_tp_vals, entry_tp1)
    if not na(entry_tp2)
        array.push(_tp_vals, entry_tp2)
    if not na(entry_tp3)
        array.push(_tp_vals, entry_tp3)
    if not na(entry_tp4)
        array.push(_tp_vals, entry_tp4)
    if not na(entry_tp5)
        array.push(_tp_vals, entry_tp5)

    int _n = array.size(_tp_vals)
    // tạo table với đúng số hàng: header + tf + entry + n_tp + sl + time = n + 5
    panel = table.new(panel_pos, 1, _n + 5,
         border_color=color.new(color.gray, 50), border_width=1,
         frame_color=color.new(color.gray, 30),  frame_width=2)

    table.cell(panel, 0, 0, p_header, text_color=color.white, bgcolor=p_hdr_bg, text_size=_sz, text_halign=text.align_left)
    table.cell(panel, 0, 1, p_tf,     text_color=color.white, bgcolor=_bg,      text_size=_sz, text_halign=text.align_left)
    table.cell(panel, 0, 2, p_entry,  text_color=color.white, bgcolor=_bg,      text_size=_sz, text_halign=text.align_left)

    // chỉ render đúng số TP có giá trị, không có hàng trống
    if _n > 0
        for i = 0 to _n - 1
            _lbl = "🎯 TP" + str.tostring(i + 1) + ": " + _fmt(array.get(_tp_vals, i))
            table.cell(panel, 0, 3 + i, _lbl, text_color=_clr_tp, bgcolor=_bg, text_size=_sz, text_halign=text.align_left)

    table.cell(panel, 0, 3 + _n, p_sl,   text_color=_clr_sl, bgcolor=_bg, text_size=_sz, text_halign=text.align_left)
    table.cell(panel, 0, 4 + _n, p_time, text_color=_clr_gw, bgcolor=_bg, text_size=_sz, text_halign=text.align_left)

// --- HIỂN THỊ ---
plot(ema_val_filter, title="EMA Filter", color=above_ema ? color.new(color.green, 20) : color.new(color.red, 20), linewidth=2)

plotshape(use_ema and buy_raw  and not above_ema, title="Buy (bị lọc)",  text="✗", style=shape.labelup,   location=location.belowbar, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)
plotshape(use_ema and sell_raw and not below_ema, title="Sell (bị lọc)", text="✗", style=shape.labeldown, location=location.abovebar, color=color.new(color.gray, 50), textcolor=color.white, size=size.tiny)

plotshape(long_entry,  title="Buy",  text="Buy",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(short_entry, title="Sell", text="Sell", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)

barcolor(barbuy  ? color.green : na)
barcolor(barsell ? color.red   : na)

// --- ALERTS (plain text — giống format Telegram) ---
_t  = syminfo.ticker
_tf = timeframe.period
_ex = syminfo.prefix
_ec = _fmt(entry_close)
_hp = _fmt(hit_price)

_entry_long_msg  = "🟢 BUY ▲ | " + _t + "\n⏱ Khung: " + _tf + "  |  Sàn: " + _ex +
     "\n💰 Giá vào: " + _ec +
     "\n🎯 TP1: " + _fmt(entry_tp1) + "  TP2: " + _fmt(entry_tp2) + "  TP3: " + _fmt(entry_tp3) +
     "\n🎯 TP4: " + _fmt(entry_tp4) + "  TP5: " + _fmt(entry_tp5) +
     "\n🛑 SL: "  + _fmt(entry_sl)

_entry_short_msg = "🔴 SELL ▼ | " + _t + "\n⏱ Khung: " + _tf + "  |  Sàn: " + _ex +
     "\n💰 Giá vào: " + _ec +
     "\n🎯 TP1: " + _fmt(entry_tp1) + "  TP2: " + _fmt(entry_tp2) + "  TP3: " + _fmt(entry_tp3) +
     "\n🎯 TP4: " + _fmt(entry_tp4) + "  TP5: " + _fmt(entry_tp5) +
     "\n🛑 SL: "  + _fmt(entry_sl)

if long_entry
    alert(_entry_long_msg, alert.freq_once_per_bar_close)
    entry_alert_sent := true

if short_entry
    alert(_entry_short_msg, alert.freq_once_per_bar_close)
    entry_alert_sent := true

if trade_dir == 1 and not entry_alert_sent and entry_confirmed and bar_index > entry_bar_index
    alert(_entry_long_msg, alert.freq_once_per_bar)

if trade_dir == -1 and not entry_alert_sent and entry_confirmed and bar_index > entry_bar_index
    alert(_entry_short_msg, alert.freq_once_per_bar)

if (trade_dir == 1 or trade_dir == -1) and not entry_alert_sent and entry_confirmed and bar_index > entry_bar_index and barstate.isconfirmed
    entry_alert_sent := true

if long_tp1_hit
    alert("✅ BUY TP1 ✅ | " + _t + "\n⏱ Khung: " + _tf + "\n💰 Giá chạm TP1: " + _hp, alert.freq_once_per_bar)
if long_tp2_hit
    alert("🎯 BUY TP2 ✅✅ | " + _t + "\n⏱ Khung: " + _tf + "\n💰 Giá chạm TP2: " + _hp, alert.freq_once_per_bar)
if long_tp3_hit
    alert("💰 BUY TP3 ✅✅✅ | " + _t + "\n⏱ Khung: " + _tf + "\n💰 Giá chạm TP3: " + _hp, alert.freq_once_per_bar)
if long_tp4_hit
    alert("💎 BUY TP4 ✅✅✅✅ | " + _t + "\n⏱ Khung: " + _tf + "\n💰 Giá chạm TP4: " + _hp, alert.freq_once_per_bar)
if long_tp5_hit
